{
  "type": "object",
  "properties": {
    "proposalVersion": {
      "type": "string",
      "enum": [
        "claims-draft-1"
      ]
    },
    "analysisTarget": {
      "type": "string",
      "minLength": 1
    },
    "decomposition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "SINGLE",
            "MULTIPLE"
          ]
        },
        "basis": {
          "type": "string",
          "enum": [
            "SINGLE_PROPOSITION",
            "EXPLICIT_CONJUNCTION",
            "EXPLICIT_DIMENSIONS"
          ]
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "basis",
        "explanation"
      ],
      "additionalProperties": false
    },
    "claims": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "inputExcerpt": {
            "type": "string",
            "minLength": 1
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "verdict": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "SUPPORTED",
                  "REFUTED",
                  "MISLEADING",
                  "INSUFFICIENT_EVIDENCE",
                  "OPINION"
                ]
              },
              "explanation": {
                "type": "string",
                "minLength": 1
              },
              "documentarySupport": {
                "type": "string",
                "minLength": 1
              },
              "sourceIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true
              }
            },
            "required": [
              "status",
              "explanation",
              "documentarySupport",
              "sourceIds"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "inputExcerpt",
          "proposition",
          "verdict"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "proposalVersion",
    "analysisTarget",
    "decomposition",
    "claims"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft claim assessment fragment; not the active provider report"
}
