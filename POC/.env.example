# Copy to .env; never commit credentials.
# Exactly one provider: replay, dev or openai. No local profile in containers.
ANALYSIS_PROFILE=replay
REPLAY_SCENARIO=PLUS_ULTRA_V20
CONVERSATION_TOKEN_SECRET=
# Required only for openai:
OPENAI_API_KEY=
OPENAI_POLITICAL_ANALYSIS_AGENT_ID=
POLITICAL_AGENT_REVISION=political-v21
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8088

# Local API documentation; disable for a public deployment unless access is protected.
API_DOCS_ENABLED=true
