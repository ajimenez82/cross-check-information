# Server-only configuration; keep the real .env private (chmod 600).
DOMAIN=www.contrastaloquetecuenten.com
ACME_EMAIL=
RELEASE_TAG=
# Start with replay; switch to openai after verifying deployment.
ANALYSIS_PROFILE=replay
REPLAY_SCENARIO=PLUS_ULTRA_V20
CONVERSATION_TOKEN_SECRET=
OPENAI_API_KEY=
OPENAI_POLITICAL_ANALYSIS_AGENT_ID=
POLITICAL_AGENT_REVISION=political-v21
BETA_USERNAME=beta
# Single-quote the bcrypt hash to preserve dollar signs in Compose.
BETA_PASSWORD_HASH=
# Initial sizing for 1 GB; 512 MB needs separate capacity validation.
API_MEMORY_LIMIT=480m
WEB_MEMORY_LIMIT=64m
EDGE_MEMORY_LIMIT=96m
JAVA_TOOL_OPTIONS=-Xms64m -Xmx256m -XX:ActiveProcessorCount=2

